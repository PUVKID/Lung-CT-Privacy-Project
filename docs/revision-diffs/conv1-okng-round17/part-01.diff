+    nonmember_val=scores(rows['validation']);nonmember_test=scores(rows['test'])
+    if ({r['patient_id'] for r in member_val+nonmember_val}&{r['patient_id'] for r in member_test+nonmember_test}): raise ValueError('멤버십 선정·최종 환자 중복')
