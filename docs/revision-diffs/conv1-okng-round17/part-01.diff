+    try:
+        with temp.open("w", encoding="utf-8", newline="\n") as f:
+            json.dump(value, f, ensure_ascii=False, indent=2, allow_nan=False)
+            f.write("\n")
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(temp, path)
+    finally:
