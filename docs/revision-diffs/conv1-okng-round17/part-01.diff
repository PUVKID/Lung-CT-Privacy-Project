+        if not patients or patients&seen: raise ValueError('SCI 환자 분할 간 중복')
+        if any(row['label'] not in (0,1) or row['cohort']!='LUNA25' for row in rows): raise ValueError('LUNA25 주실험 라벨·cohort 오류')
