+    for sigma, profile in conditions(config):
+        cid = condition_id(sigma, profile)
+        folder = runtime / 'conditions' / cid
+        item = {'id': cid, 'sigma': sigma, 'profile': profile, 'state': 'not_started', 'epoch': 0}
+        if (folder / 'current.json').exists():
