+    if index['run_id'] != RUN or index['source_manifest_sha256'] != digest(manifest_path) or index['samples_private'] != samples:
+        raise ValueError('기존 출력의 실행·입력 목록이 현재 계약과 다릅니다.')
+    for item in index['items']:
