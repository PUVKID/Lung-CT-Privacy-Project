+        "        counts = d.get(\"counts\", {})\n",
+        "        lbl    = condition_short_label(block_size, sigma)\n",
+        "        acc    = r[\"acc\"] * 100\n",
+        "        auc    = r[\"roc_auc\"]\n",
+        "        print(f\"  {lbl:>24}  {acc:>7.2f}%  {auc:>8.4f}  \"\n",
+        "              f\"{status:>12}  \"\n",
+        "              f\"정상 {counts.get('good',0)} / 과적합 {counts.get('overfit',0)} / 과소적합 {counts.get('underfit',0)}\")\n",
+        "\n",
+        "print(\"=\" * 60)\n"
+      ]
