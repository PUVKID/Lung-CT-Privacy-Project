+        "                break\n",
+        "\n",
+        "            src_f = rng.choice(src_files)\n",
+        "            try:\n",
+        "                img = Image.open(os.path.join(base_dir, cls, src_f)).convert(\"RGB\")\n",
+        "                img = img.rotate(rng.uniform(-30, 30), expand=False)\n",
