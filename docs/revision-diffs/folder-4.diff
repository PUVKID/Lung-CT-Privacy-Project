+        "    print(f\"  │  train_loss: {d.get('train_loss_final',0):6.4f}  val_loss: {d.get('val_loss_final',0):6.4f}               │\")\n",
+        "    print(f\"  │  acc_gap   : {d.get('acc_gap',0)*100:+5.1f}%  loss_gap: {d.get('loss_gap',0):+6.4f}               │\")\n",
