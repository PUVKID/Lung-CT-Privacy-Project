+        "\n",
+        "    total = sum(len(list_image_files(os.path.join(out_dir, c))) for c in classes)\n",
+        "    print(f\"    ✅ 오버샘플링 완료: {total}장 → {out_dir}\")\n",
+        "    print(f\"    ✅ 원본 파일({base_dir}) 보존 확인\")\n",
