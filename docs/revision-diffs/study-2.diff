+      "source": [
+        "# Cell 11: 단일 블록 크기 실험 함수 (누수 없는 올바른 순서)\n",
+        "def run_experiment(block_size, block_dir):\n",
+        "    exp_idx  = BLOCK_SIZES.index(block_size) if block_size in BLOCK_SIZES else 0\n",
+        "    exp_seed = SEED + exp_idx * 1000\n",
