+    "                img = img.rotate(rng.uniform(-30, 30), expand=False)\n",
+    "                if rng.random() > 0.5: img = img.transpose(Image.FLIP_LEFT_RIGHT)\n",
+    "                if rng.random() > 0.5: img = img.transpose(Image.FLIP_TOP_BOTTOM)\n",
+    "                from PIL import ImageEnhance\n",
