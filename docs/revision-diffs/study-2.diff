+    "        )\n",
+    "        if r.returncode == 0:\n",
+    "            parts = [p.strip() for p in r.stdout.strip().split(\",\")]\n",
+    "            used, total, util, temp = int(parts[0]), int(parts[1]), parts[2], parts[3]\n",
