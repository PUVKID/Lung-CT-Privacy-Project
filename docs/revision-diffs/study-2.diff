+    "def _bar_colors(values, vmin=None, vmax=None, cmap_name=\"RdYlGn\"):\n",
+    "    \"\"\"값이 높을수록 초록, 낮을수록 빨강/주황이 되도록 색을 매긴다.\"\"\"\n",
+    "    vals = np.asarray(values, dtype=float)\n",
