+    "# 5. 이미지 + 라벨 합치기\n",
+    "# =========================================================\n",
+    "\n",
+    "def add_label(img, text):\n",
+    "\n",
+    "    # 이미지 아래에 라벨 영역 추가\n",
+    "    canvas = Image.new(\n",
+    "        \"RGB\",\n",
+    "        (w, h + label_area_h),\n",
+    "        \"white\"\n",
+    "    )\n",
+    "\n",
+    "    # 원본 이미지 붙이기\n",
+    "    canvas.paste(\n",
+    "        img,\n",
+    "        (0, 0)\n",
+    "    )\n",
+    "\n",
+    "    draw = ImageDraw.Draw(canvas)\n",
+    "\n",
+    "    # 글자 크기 측정\n",
+    "    bbox = draw.textbbox(\n",
+    "        (0, 0),\n",
+    "        text,\n",
+    "        font=font\n",
+    "    )\n",
+    "\n",
+    "    text_w = bbox[2] - bbox[0]\n",
+    "    text_h = bbox[3] - bbox[1]\n",
+    "\n",
+    "    # 가운데 정렬\n",
+    "    x = (w - text_w) // 2\n",
+    "\n",
+    "    # 라벨 영역 중앙 정렬\n",
+    "    y = (\n",
+    "        h\n",
+    "        + (label_area_h - text_h) // 2\n",
+    "        - bbox[1]\n",
+    "    )\n",
+    "\n",
+    "    # 검정색 Bold 글자\n",
+    "    draw.text(\n",
+    "        (x, y),\n",
+    "        text,\n",
+    "        font=font,\n",
+    "        fill=\"black\"\n",
+    "    )\n",
+    "\n",
+    "    return canvas\n",
+    "\n",
+    "\n",
+    "panels = [\n",
+    "    add_label(img, label)\n",
+    "    for img, label in zip(imgs, labels)\n",
+    "]\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 6. 2 x 2 합성\n",
+    "# =========================================================\n",
+    "\n",
+    "cell_w = w + gap\n",
+    "cell_h = (h + label_area_h) + gap\n",
+    "\n",
+    "grid_w = cell_w * 2 - gap\n",
+    "grid_h = cell_h * 2 - gap\n",
+    "\n",
+    "grid = Image.new(\n",
+    "    \"RGB\",\n",
+    "    (grid_w, grid_h),\n",
+    "    \"white\"\n",
+    ")\n",
+    "\n",
+    "positions = [\n",
+    "    (0, 0),\n",
+    "    (cell_w, 0),\n",
+    "    (0, cell_h),\n",
+    "    (cell_w, cell_h)\n",
+    "]\n",
+    "\n",
+    "for panel, pos in zip(\n",
+    "    panels,\n",
+    "    positions\n",
+    "):\n",
+    "    grid.paste(\n",
+    "        panel,\n",
+    "        pos\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 7. 결과 저장\n",
+    "# =========================================================\n",
+    "\n",
+    "output_path = (\n",
+    "    r\".\\2026\\폐암 논문\"\n",
+    "    r\"\\블록 + 블러\\실험 완료\"\n",
+    "    r\"\\privacy_composite_2x2.png\"\n",
+    ")\n",
+    "\n",
+    "grid.save(\n",
+    "    output_path,\n",
+    "    quality=100\n",
+    ")\n",
+    "\n",
+    "print()\n",
+    "print(\"========================================\")\n",
+    "print(\"완료!\")\n",
+    "print(f\"저장 위치:\\n{output_path}\")\n",
+    "print(\"========================================\")"
+   ]
+  }
