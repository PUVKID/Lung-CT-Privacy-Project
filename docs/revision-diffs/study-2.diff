+    "\n",
+    "\n",
+    "def draw_heatmap(data, cmap, vmin, vmax, cbar_label, fname, text_threshold_frac=0.5):\n",
+    "    # 문서 삽입 크기(너비 70 x 높이 60)와 동일한 7:6 비율로 그려서\n",
