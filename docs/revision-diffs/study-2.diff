+        "_COLORS_ALL  = [CMAP(i / max(_N_valid - 1, 1)) for i in range(_N_valid)]\n",
+        "\n",
+        "# 1. 전체 정확도 막대 ────────────────────────────────────────────────────\n",
+        "print(\"\\n📊 [종합 1/10] 전체 정확도 막대\")\n",
+        "fig, ax = plt.subplots(figsize=(22, 5))\n",
+        "bars = ax.bar(_valid_labels, _all_accs, color=_COLORS_ALL, edgecolor=\"#555\", lw=0.6, zorder=3)\n",
