+        "\n",
+        "    for b, v in zip(bars, values):\n",
+        "        ax.text(\n",
+        "            b.get_x() + b.get_width() / 2,\n",
+        "            v + pad,\n",
+        "            value_fmt.format(v),\n",
+        "            ha=\"center\",\n",
