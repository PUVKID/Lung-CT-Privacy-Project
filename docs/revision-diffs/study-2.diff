+    "# 여기 숫자만 따로 수정하면 됨\n",
+    "#\n",
+    "# AXIS_LABEL_FS : X/Y축 제목\n",
+    "# TICK_FS       : X/Y축 눈금\n",
+    "# ANNOT_FS      : Privacy Score 수치\n",
+    "# LEGEND_FS     : 범례 글자\n",
+    "# LEGEND_MS     : 범례 기호\n",
+    "#\n",
+    "# ===========================================================================\n",
+    "\n",
+    "AXIS_LABEL_FS = 40\n",
+    "TICK_FS       = 30\n",
+    "ANNOT_FS      = 35\n",
+    "LEGEND_FS     = 30\n",
+    "LEGEND_MS     = 20\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Graph style\n",
+    "# ===========================================================================\n",
+    "\n",
+    "LW = 4.2\n",
+    "MS = 13\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Figure function\n",
+    "# ===========================================================================\n",
+    "\n",
+    "def make_figure(\n",
+    "    labels,\n",
+    "    privacy,\n",
+    "    ssim,\n",
+    "    psnr,\n",
+    "    x_title,\n",
+    "    out_path\n",
+    "):\n",
+    "\n",
+    "    # -----------------------------------------------------------------------\n",
+    "    # Figure\n",
+    "    # -----------------------------------------------------------------------\n",
+    "\n",
+    "    fig, ax = plt.subplots(\n",
+    "        figsize=(15, 9.5)\n",
+    "    )\n",
+    "\n",
+    "    ax2 = ax.twinx()\n",
+    "\n",
+    "    x = list(range(len(labels)))\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Main graph lines\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    # Privacy Score\n",
+    "    ax.plot(\n",
+    "        x,\n",
+    "        privacy,\n",
+    "        color=C_PRIVACY,\n",
+    "        marker=\"o\",\n",
+    "        linewidth=LW,\n",
+    "        markersize=MS,\n",
+    "        markerfacecolor=C_PRIVACY,\n",
+    "        markeredgecolor=C_PRIVACY\n",
+    "    )\n",
+    "\n",
+    "    # SSIM\n",
+    "    ax.plot(\n",
+    "        x,\n",
+    "        [s * 100 for s in ssim],\n",
+    "        color=C_SSIM,\n",
+    "        marker=\"^\",\n",
+    "        linewidth=LW,\n",
+    "        markersize=MS,\n",
+    "        linestyle=\"--\",\n",
+    "        markerfacecolor=C_SSIM,\n",
+    "        markeredgecolor=C_SSIM\n",
+    "    )\n",
+    "\n",
+    "    # PSNR\n",
+    "    ax2.plot(\n",
+    "        x,\n",
+    "        psnr,\n",
+    "        color=C_PSNR,\n",
+    "        marker=\"s\",\n",
+    "        linewidth=LW,\n",
+    "        markersize=MS,\n",
+    "        linestyle=\":\",\n",
+    "        markerfacecolor=C_PSNR,\n",
+    "        markeredgecolor=C_PSNR\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Privacy Score annotations\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    for i, (xi, yi) in enumerate(zip(x, privacy)):\n",
+    "\n",
+    "        if i % 2 == 0:\n",
+    "            dy = 20\n",
+    "            va = \"bottom\"\n",
+    "        else:\n",
+    "            dy = -28\n",
+    "            va = \"top\"\n",
+    "\n",
+    "        ax.annotate(\n",
+    "            f\"{yi:.1f}\",\n",
+    "            (xi, yi),\n",
+    "\n",
+    "            textcoords=\"offset points\",\n",
+    "            xytext=(0, dy),\n",
+    "\n",
+    "            ha=\"center\",\n",
+    "            va=va,\n",
+    "\n",
+    "            fontsize=ANNOT_FS,\n",
+    "            fontproperties=FP_BOLD,\n",
+    "            color=\"black\"\n",
+    "        )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # X-axis\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    ax.set_xticks(x)\n",
+    "\n",
+    "    ax.set_xticklabels(\n",
+    "        labels,\n",
+    "        fontsize=TICK_FS,\n",
+    "        fontproperties=FP_BOLD,\n",
+    "        color=\"black\"\n",
+    "    )\n",
+    "\n",
+    "    ax.set_xlabel(\n",
+    "        x_title,\n",
+    "        fontsize=AXIS_LABEL_FS,\n",
+    "        fontproperties=FP_BOLD,\n",
+    "        color=\"black\",\n",
+    "        labelpad=16\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Y-axis\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    ax.set_ylabel(\n",
+    "        \"Privacy Score / SSIM x100\",\n",
+    "        fontsize=AXIS_LABEL_FS,\n",
+    "        fontproperties=FP_BOLD,\n",
+    "        color=\"black\",\n",
+    "        labelpad=16\n",
+    "    )\n",
+    "\n",
+    "    ax2.set_ylabel(\n",
+    "        \"PSNR (dB, log scale)\",\n",
+    "        fontsize=AXIS_LABEL_FS,\n",
+    "        fontproperties=FP_BOLD,\n",
+    "        color=\"black\",\n",
+    "        labelpad=20\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Axis range\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    ax.set_ylim(\n",
+    "        -10,\n",
+    "        112\n",
+    "    )\n",
+    "\n",
+    "    ax2.set_yscale(\n",
+    "        \"log\"\n",
+    "    )\n",
+    "\n",
+    "    ax2.set_ylim(\n",
+    "        4,\n",
+    "        140\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Tick labels\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    for label in ax.get_xticklabels():\n",
+    "\n",
+    "        label.set_fontproperties(FP_BOLD)\n",
+    "        label.set_fontsize(TICK_FS)\n",
+    "        label.set_color(\"black\")\n",
+    "\n",
+    "\n",
+    "    for label in ax.get_yticklabels():\n",
+    "\n",
+    "        label.set_fontproperties(FP_BOLD)\n",
+    "        label.set_fontsize(TICK_FS)\n",
+    "        label.set_color(\"black\")\n",
+    "\n",
+    "\n",
+    "    for label in ax2.get_yticklabels():\n",
+    "\n",
+    "        label.set_fontproperties(FP_BOLD)\n",
+    "        label.set_fontsize(TICK_FS)\n",
+    "        label.set_color(\"black\")\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Tick marks\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    ax.tick_params(\n",
+    "        axis=\"x\",\n",
+    "        labelsize=TICK_FS,\n",
+    "        colors=\"black\"\n",
+    "    )\n",
+    "\n",
+    "    ax.tick_params(\n",
+    "        axis=\"y\",\n",
+    "        labelsize=TICK_FS,\n",
+    "        colors=\"black\"\n",
+    "    )\n",
+    "\n",
+    "    ax2.tick_params(\n",
+    "        axis=\"y\",\n",
+    "        labelsize=TICK_FS,\n",
+    "        colors=\"black\"\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Grid\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    ax.grid(\n",
+    "        alpha=0.25\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Legend\n",
+    "    #\n",
+    "    # ● Privacy Score\n",
+    "    # ▲ Single-scale SSIM x100 (ref.)\n",
+    "    # ■ PSNR, dB (ref.)\n",
+    "    #\n",
+    "    # 기호는 유지\n",
+    "    # 기호를 관통하는 선은 없음\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    legend_handles = [\n",
+    "\n",
+    "        Line2D(\n",
+    "            [0],\n",
+    "            [0],\n",
+    "\n",
+    "            marker=\"o\",\n",
+    "            linestyle=\"None\",\n",
+    "\n",
+    "            color=C_PRIVACY,\n",
+    "\n",
+    "            markerfacecolor=C_PRIVACY,\n",
+    "            markeredgecolor=C_PRIVACY,\n",
+    "\n",
+    "            markersize=LEGEND_MS,\n",
+    "\n",
+    "            label=\"Privacy Score\"\n",
+    "        ),\n",
+    "\n",
+    "        Line2D(\n",
+    "            [0],\n",
+    "            [0],\n",
+    "\n",
+    "            marker=\"^\",\n",
+    "            linestyle=\"None\",\n",
+    "\n",
+    "            color=C_SSIM,\n",
+    "\n",
+    "            markerfacecolor=C_SSIM,\n",
+    "            markeredgecolor=C_SSIM,\n",
+    "\n",
+    "            markersize=LEGEND_MS,\n",
+    "\n",
+    "            label=\"Single-scale SSIM x100 (ref.)\"\n",
+    "        ),\n",
+    "\n",
+    "        Line2D(\n",
+    "            [0],\n",
+    "            [0],\n",
+    "\n",
+    "            marker=\"s\",\n",
+    "            linestyle=\"None\",\n",
+    "\n",
+    "            color=C_PSNR,\n",
+    "\n",
+    "            markerfacecolor=C_PSNR,\n",
+    "            markeredgecolor=C_PSNR,\n",
+    "\n",
+    "            markersize=LEGEND_MS,\n",
+    "\n",
+    "            label=\"PSNR, dB (ref.)\"\n",
+    "        )\n",
+    "    ]\n",
+    "\n",
+    "\n",
+    "    legend = ax.legend(\n",
+    "        handles=legend_handles,\n",
+    "\n",
+    "        loc=\"upper right\",\n",
+    "\n",
+    "        fontsize=LEGEND_FS,\n",
+    "\n",
+    "        frameon=True,\n",
+    "        framealpha=0.92,\n",
+    "\n",
+    "        borderpad=0.8,\n",
+    "        labelspacing=0.7,\n",
+    "        handletextpad=0.7,\n",
+    "        borderaxespad=0.8\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Legend font\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    for text in legend.get_texts():\n",
+    "\n",
+    "        text.set_fontproperties(FP_BOLD)\n",
+    "        text.set_fontsize(LEGEND_FS)\n",
+    "        text.set_color(\"black\")\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Legend title / frame\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    legend.get_frame().set_linewidth(1.0)\n",
+    "    legend.get_frame().set_edgecolor(\"black\")\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Layout\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    plt.tight_layout()\n",
+    "\n",
+    "\n",
+    "    # =======================================================================\n",
+    "    # Save\n",
+    "    # =======================================================================\n",
+    "\n",
+    "    plt.savefig(\n",
+    "        out_path,\n",
+    "        dpi=300,\n",
+    "        bbox_inches=\"tight\",\n",
+    "        facecolor=\"white\"\n",
+    "    )\n",
+    "\n",
+    "    plt.close(fig)\n",
+    "\n",
+    "    print(f\"[saved] {out_path}\")\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Output folder\n",
+    "# ===========================================================================\n",
+    "\n",
+    "OUT_DIR = os.path.join(\n",
+    "    os.path.expanduser(\"~\"),\n",
+    "    \"Desktop\",\n",
+    "    \"privacy_score_figures\"\n",
+    ")\n",
+    "\n",
+    "os.makedirs(\n",
+    "    OUT_DIR,\n",
+    "    exist_ok=True\n",
+    ")\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Generate Block figure\n",
+    "# ===========================================================================\n",
+    "\n",
+    "make_figure(\n",
+    "    block_labels,\n",
+    "    block_privacy,\n",
+    "    block_ssim,\n",
+    "    block_psnr,\n",
+    "\n",
+    "    \"Block Size (px)\",\n",
+    "\n",
+    "    os.path.join(\n",
+    "        OUT_DIR,\n",
+    "        \"privacy_score_block.png\"\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Generate Blur figure\n",
+    "# ===========================================================================\n",
+    "\n",
+    "make_figure(\n",
+    "    blur_labels,\n",
+    "    blur_privacy,\n",
+    "    blur_ssim,\n",
+    "    blur_psnr,\n",
+    "\n",
+    "    \"Gaussian Blur sigma\",\n",
+    "\n",
+    "    os.path.join(\n",
+    "        OUT_DIR,\n",
+    "        \"privacy_score_blur.png\"\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "\n",
+    "# ===========================================================================\n",
+    "# Done\n",
+    "# ===========================================================================\n",
+    "\n",
+    "print()\n",
+    "print(\"========================================\")\n",
+    "print(\"All figures saved successfully.\")\n",
+    "print(f\"Output folder: {OUT_DIR}\")\n",
+    "print(\"========================================\")"
+   ]
+  }
