+        "    lo = vmin if vmin is not None else np.nanmin(vals)\n",
+        "    hi = vmax if vmax is not None else np.nanmax(vals)\n",
+        "\n",
+        "    if hi - lo < 1e-9:\n",
+        "        norm_vals = np.ones_like(vals) * 0.6\n",
+        "    else:\n",
+        "        norm_vals = (vals - lo) / (hi - lo)\n",
+        "        norm_vals = 0.15 + norm_vals * 0.75\n",
