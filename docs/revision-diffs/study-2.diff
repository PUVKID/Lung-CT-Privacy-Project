+      "source": [
+        "## 9️⃣ 학습 기법 (Focal Loss / Cosine LR / SWA)\n"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "execution_count": 22,
+      "id": "b7a66d2f",
