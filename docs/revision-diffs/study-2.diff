+    "# Cell 10b: 과적합/과소적합 진단 함수 & 모니터 콜백\n",
+    "GPU_LOG = []\n",
+    "\n",
+    "def diagnose_fit(train_loss, val_loss, train_acc, val_acc):\n",
+    "    if len(train_loss) == 0 or len(val_loss) == 0:\n",
+    "        return \"unknown\", {}\n",
+    "\n",
+    "    tl = float(train_loss[-1])\n",
