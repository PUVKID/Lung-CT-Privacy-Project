+        "            fontsize=value_fontsize,\n",
+        "            fontweight=\"bold\",\n",
+        "            color=\"#1a1a1a\"\n",
+        "        )\n",
+        "\n",
+        "    # 기준선\n",
+        "    handles, labels_leg = [], []\n",
+        "\n",
+        "    if show_max:\n",
+        "        mx = np.nanmax(values)\n",
+        "        h = ax.axhline(\n",
+        "            mx,\n",
