+        "                CosineAnnealingWarmRestart(lr_max=1e-3, lr_min=1e-5, T0=5, T_mult=2),\n",
+        "                mon],\n",
+        "            class_weight=cw, verbose=1)\n",
+        "\n",
+        "        # Stage 2: fine-tuning\n",
+        "        model = load_model(TEMP, custom_objects={\"loss_fn\": focal_loss(2.0, 0.05)})\n",
+        "        bl = None\n",
+        "        for lyr in model.layers:\n",
+        "            if hasattr(lyr, \"layers\") and len(getattr(lyr, \"layers\", [])) > 10:\n",
+        "                bl = lyr; break\n",
+        "        if bl:\n",
+        "            bl.trainable = True\n",
+        "            for l in bl.layers[:-30]: l.trainable = False\n",
+        "\n",
+        "        swa = SWACallback(SWA_START, 1e-5)\n",
+        "        model.compile(\n",
+        "            optimizer=AdamW(learning_rate=1e-4, weight_decay=1e-4),\n",
+        "            loss=focal_loss(2.0, 0.02), metrics=[\"accuracy\"])\n",
+        "        h2 = model.fit(\n",
+        "            apply_mixup_cutmix(tr_ds, 0.1, cutmix_prob=0.3),\n",
+        "            steps_per_epoch=tr_steps,\n",
+        "            validation_data=va_ds.repeat(), validation_steps=va_steps,\n",
+        "            epochs=EPOCHS_S2,\n",
+        "            callbacks=[\n",
+        "                EarlyStopping(\"val_loss\", patience=45, min_delta=1e-4,\n",
+        "                              restore_best_weights=True, verbose=0),\n",
+        "                TerminateOnNaN(),\n",
+        "                OverfitControlCallback(min_epochs=35, patience=10,\n",
