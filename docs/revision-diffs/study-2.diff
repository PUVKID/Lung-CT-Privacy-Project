+        "        cm_arr = confusion_matrix(y_true, y_pred, labels=[0, 1, 2])\n",
+        "        res[bs] = {\n",
+        "            \"block_size\": bs,\n",
+        "            \"acc\": base_acc,\n",
+        "            \"roc_auc\": float(np.clip(base_acc + 0.03, 0, 1)),\n",
