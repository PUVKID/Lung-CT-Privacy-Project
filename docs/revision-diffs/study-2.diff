+    "            color=\"#2f9e8f\",\n",
+    "            linestyle=\"--\",\n",
+    "            linewidth=1.4,\n",
+    "            zorder=2\n",
+    "        )\n",
+    "        handles.append(h)\n",
+    "        labels_leg.append(\n",
+    "            f\"Min {mn:.1f}{'%' if '%' in value_fmt else ''}\"\n",
+    "        )\n",
+    "\n",
+    "    if threshold is not None:\n",
+    "        h = ax.axhline(\n",
+    "            threshold,\n",
+    "            color=\"#888888\",\n",
+    "            linestyle=\":\",\n",
+    "            linewidth=1.4,\n",
+    "            zorder=2\n",
+    "        )\n",
+    "        handles.append(h)\n",
+    "        labels_leg.append(\n",
