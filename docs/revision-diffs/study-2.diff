+        "    fig, ax = plt.subplots(figsize=figsize)\n",
+        "\n",
+        "    bars = ax.bar(\n",
+        "        labels,\n",
+        "        values,\n",
+        "        color=colors,\n",
+        "        edgecolor=\"none\",\n",
+        "        zorder=3,\n",
+        "        width=0.62\n",
+        "    )\n",
