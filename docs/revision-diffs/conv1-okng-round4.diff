+HERE = Path(__file__).resolve().parent
+PROJECT = HERE.parents[1]
+TRAIN = PROJECT / '2차'
+REFERENCE = Path('참고 특징맵')
+RUN = ''
+SIGMAS = [0, 1, 2, 4, 8, 16, 32, 64, 128, 256]
+CLASSES = [('Bengin_cases', 'Bengin cases', '양성 · OK'),
