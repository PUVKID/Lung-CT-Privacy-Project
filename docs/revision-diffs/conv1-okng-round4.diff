+    def test_bytes_and_decoded_pixels_never_cross_splits(self):
+        data = load_module("src.data")
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            self.make_images(root)
+            manifest = data.discover_images(root)
