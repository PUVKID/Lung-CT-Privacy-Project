+def load_module(name):
+    try:
+        return importlib.import_module(name)
+    except ModuleNotFoundError as exc:
+        if exc.name in {"src", name}:
+            raise AssertionError(f"아직 구현되지 않은 학습 모듈: {name}") from exc
+        raise
