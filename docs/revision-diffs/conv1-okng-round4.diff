+class SphericalHarmonics3 {
+
+	/**
+	 * Constructs a new spherical harmonics.
+	 */
+	constructor() {
+
+		/**
+		 * This flag can be used for type testing.
+		 *
+		 * @type {boolean}
+		 * @readonly
+		 * @default true
+		 */
